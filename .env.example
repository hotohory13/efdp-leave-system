# --- EFDP configuration -------------------------------------------------
# Copy this file to .env and adjust. Zero-config default = SQLite, no
# external services required.

# Database. SQLite (default, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./efdp.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://efdp:efdp@db:5432/efdp

# JWT auth
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# App
APP_NAME=EFDP - Employee & Leave Management System
FACULTY_NAME=Faculty of Engineering, Ahram Canadian University
DEVELOPER_CREDIT=Developer: ENG. Omar Yasser
ENVIRONMENT=development

# Business rules (see docs/BUSINESS_RULES.md — every one of these mirrors an
# explicit open decision (OD-xx) in the original EFSOP documents; change
# here rather than in code).
WEEKEND_DAYS=4,5
# 0=Mon .. 6=Sun. Default 4,5 = Friday & Saturday (Egypt working week).
CASUAL_LEAVE_DEDUCTS_FROM_ANNUAL=false
# OD-xx in EFDP-LeaveTypes.xlsx left this UNCONFIRMED. Defaulting to "No"
# (does not deduct) to match the shipped seed data — CONFIRM against the
# faculty bylaw (لائحة شؤون العاملين) before go-live, see docs/BUSINESS_RULES.md.
APPROVAL_STAGE_1_SLA_HOURS=24
APPROVAL_STAGE_2_SLA_HOURS=24
APPROVAL_ESCALATION_HOURS=48
REJECTION_NOTE_MIN_LENGTH=10
RETRO_JUSTIFICATION_MIN_LENGTH=15

# Notifications — stub logger by default. Fill in SMTP to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=svc-efdp@acu.edu.eg
